<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sportsbooking.mainapi.jpa.myrepository.UbigeoMyRepository">

    <select id="findAll" resultType="com.sportsbooking.mainapi.dto.ubigeo.UbigeoPeruRaw">
        SELECT inei,
               departamento,
               provincia,
               distrito,
               latitude,
               longitude
        FROM ubigeo_peru
        ORDER BY inei ASC
    </select>

</mapper>
