# Proyecto Java con Gradle - .gitignore recomendado

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Wrapper jar preserved
gradle/wrapper/gradle-wrapper.jar

# IDEs
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# Java artifacts
*.class
*.jar
*.war
*.ear

# Build / generated
out/
bin/
target/
generated-sources/
generated-test-sources/
build/reports/
build/test-results/

# OS files
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
logs/

# Temp / caches
tmp/
out/
*.tmp

# Environment files and secrets
.env
.env.*
!.env.example
application-local.yml
application-qa.yml
application-dev.yml

# Firebase / Google service account (NUNCA subir)
# Ignorar ruta concreta y cualquier fichero con ese nombre
src/main/resources/firebase-service-account.json
**/firebase-service-account.json

# Uploads / user files
uploads/

# Databases
*.db
*.sqlite
*.sqlite3

# Keystores and certs
*.keystore
*.pem
*.p12
*.pfx
*.jks

# Misc
AGENT.md
CLAUDE.md
.agent-mem/

